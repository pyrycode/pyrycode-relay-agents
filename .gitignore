# Environment (consumer-owned)
.env

# Dependencies (defense in depth — the dispatcher submodule has its
# own .gitignore for dispatcher/node_modules/, but a generic rule here
# covers any nested node_modules at agents/ root or beyond)
node_modules/

# Runtime artifacts (written by the dispatcher to <agentsRepoRoot>/)
logs/
.prompt-*
.system-prompt-*

# Codegraph index (lives in target repo, but stray dirs sometimes
# end up here during dev; keep ignored just in case)
.codegraph/

# Manual .env backups (same secrets as .env — never commit)
.env.bak-*
