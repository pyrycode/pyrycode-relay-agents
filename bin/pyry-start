#!/bin/sh
# Start the dispatcher in the foreground.
# Select a runner with --runner codex or --runner claude. Remaining args
# pass through to the dispatcher.
#
# Refuses to start if another dispatcher is already running against the
# same target repo (lock file at <TARGET_REPO_PATH>/.dispatcher.lock).
# Catches both same-fork double-start and cross-fork double-start
# targeting the same project board. Stale locks (holder PID dead) are
# cleared automatically.
#
# In a terminal, Ctrl-C drains and stops. Ctrl-R drains, then runs this
# script again from disk, so new launcher, dispatcher and .env contents
# all take effect.
set -e
SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"
AGENTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Parse launcher options before touching locks or installing dependencies.
# Stop at the dispatcher command so its arguments remain literal.
RUNNER_OVERRIDE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --runner)
      if [ "$#" -lt 2 ]; then
        echo "error: --runner requires claude or codex" >&2
        exit 2
      fi
      RUNNER_OVERRIDE="$2"
      shift 2
      ;;
    --runner=*)
      RUNNER_OVERRIDE="${1#--runner=}"
      shift
      ;;
    -h|--help)
      echo "Usage: pyry-start [--runner claude|codex] [dispatcher arguments...]"
      echo "The runner option overrides the saved setting for this launch only."
      exit 0
      ;;
    --) shift; break ;;
    *) break ;;
  esac
  case "$RUNNER_OVERRIDE" in
    claude|codex) ;;
    *) echo "error: --runner requires claude or codex" >&2; exit 2 ;;
  esac
done

# Use only the dedicated Automation service account, never a desktop login.
AUTOMATION_ACCESS="${PYRY_AUTOMATION_ACCESS:-$HOME/.local/bin/automation-access}"
if [ ! -x "$AUTOMATION_ACCESS" ]; then
  echo "error: service-account helper missing at $AUTOMATION_ACCESS" >&2
  exit 1
fi

if [ ! -d "$AGENTS_DIR/dispatcher" ]; then
  echo "error: dispatcher submodule missing at $AGENTS_DIR/dispatcher" >&2
  echo "       run: cd $AGENTS_DIR && git submodule update --init" >&2
  exit 1
fi

# Resolve TARGET_REPO_PATH the same way the dispatcher does at module
# load: env override first (process env or .env file), fall back to
# parent of agents/. Mirrors `dispatch.ts`'s `resolveTargetRepoRoot`
# precedence so the lock file lands at the same path the dispatcher
# will write logs against.
if [ -n "$TARGET_REPO_PATH" ]; then
  RESOLVED_TARGET="$TARGET_REPO_PATH"
elif [ -f "$AGENTS_DIR/.env" ]; then
  RESOLVED_TARGET=$(grep '^TARGET_REPO_PATH=' "$AGENTS_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2-)
fi
RESOLVED_TARGET="${RESOLVED_TARGET:-$(cd "$AGENTS_DIR/.." && pwd)}"
LOCK_FILE="$RESOLVED_TARGET/.dispatcher.lock"

# Pre-spawn lock check. If the lock holder's PID is still alive, refuse;
# the user must drain (or hard-stop) the existing dispatcher first.
# If the holder is dead (crashed without cleanup), warn + clear the
# stale lock and proceed.
if [ -f "$LOCK_FILE" ]; then
  LOCKED_PID=$(grep '^PID=' "$LOCK_FILE" | head -1 | cut -d= -f2)
  if [ -n "$LOCKED_PID" ] && kill -0 "$LOCKED_PID" 2>/dev/null; then
    echo "error: another dispatcher is already running against this target" >&2
    echo "       lock file: $LOCK_FILE" >&2
    sed 's/^/       /' "$LOCK_FILE" >&2
    echo "" >&2
    echo "       drain it first: bin/pyry-drain (from the agents repo holding the lock)" >&2
    echo "       or hard-stop:    bin/pyry-stop (releases lock on next pyry-start)" >&2
    exit 1
  fi
  echo "warning: stale lock at $LOCK_FILE (PID $LOCKED_PID dead) — clearing" >&2
  rm -f "$LOCK_FILE"
fi

# Keep the submodule's node_modules in sync. Cheap no-op when up to date
# (~50ms); guarantees a clean restart after a submodule SHA bump.
cd "$AGENTS_DIR/dispatcher"
pnpm install --silent

# Tell the dispatcher where the consumer's agents repo lives. The
# dispatcher reads per-agent CLAUDE.md, .env, and writes runtime
# artifacts (logs/, .prompt-*.txt, .system-prompt-*.txt) here.
export AGENTS_REPO_PATH="$AGENTS_DIR"

# Also export TARGET_REPO_PATH BEFORE node starts. The dispatcher's
# `dispatch.ts` evaluates `const repoRoot = process.env.TARGET_REPO_PATH
# ? resolve(...) : resolveTargetRepoRoot(agentsRepoRoot)` at module-top —
# BEFORE dotenv.config() runs further down the same file. Under sibling
# layout, the fallback resolves to `Projects/` (not a git repo) and the
# first `git checkout main && git pull` fails with "not a git repository".
# Pre-exporting from the .env value bypasses the dotenv-load-order bug.
# See [[Pyrycode/Lessons]] "dotenv loads after repoRoot" entry.
export TARGET_REPO_PATH="$RESOLVED_TARGET"

# Shared repository knowledge replaces Claude local memory for this consumer.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export PYRY_AUTOCURATE_MEMORY=0

# The node binary by absolute path, so `ps` (and pyry-status) show which
# node the dispatcher runs on. Catches the Homebrew-vs-nvm class of bug
# from 2026-05-03.
NODE_BIN="$(command -v node)"
if [ -z "$NODE_BIN" ]; then
  echo "error: node not found on PATH" >&2
  exit 1
fi

# Forward the terminal's signals to the dispatcher BY PID, never by
# process group. The dispatcher runs in its own group (see the launch
# below), so this trap is the only way a Ctrl+C reaches it, and the
# dispatcher's own handler then decides: first press drains, a second
# press within 5 s force-exits. TERM aimed at this wrapper drains the
# dispatcher. HUP means the terminal went away; the dispatcher tears
# its children down on it. Installed before the launch so no window
# exists in which a press reaches the wrapper's default handler and
# leaves a stale lock; before the PID is known the forward is a no-op.
# Every trap action must succeed: under `set -e` a failing trap exits
# this wrapper and leaves the dispatcher running without it.
#
# A Ctrl-R restart request is the same drain plus a flag. Ctrl-C or a
# lost terminal clears the flag, so the dispatcher just stops.
DISPATCHER_PID=""
RESTART=""
STTY_SAVED=""
forward() { [ -z "$DISPATCHER_PID" ] || kill -"$1" "$DISPATCHER_PID" 2>/dev/null || true; }
on_int() {
  if [ -n "$RESTART" ]; then
    RESTART=""
    echo "Restart cancelled. The dispatcher stops after the drain."
  fi
  forward INT
}
request_restart() {
  if [ -n "$RESTART" ]; then
    echo "Restart already requested."
    return 0
  fi
  RESTART=1
  echo ""
  echo "🔁 Restart requested: draining, then starting again from disk. Ctrl-C cancels the restart."
  forward TERM
}
restore_tty() { [ -z "$STTY_SAVED" ] || stty "$STTY_SAVED" 2>/dev/null || true; }
trap 'on_int' INT
trap 'forward TERM' TERM
trap 'RESTART=""; forward HUP' HUP
trap "restore_tty; rm -f '$LOCK_FILE'" EXIT

# The launch. Three things about this line, each of which has cost a
# stranded ticket when it was wrong:
#
# 1. `node --import tsx`, NOT the tsx command-line wrapper. The wrapper
#    runs the dispatcher as a child and relays signals to it, waiting
#    30 ms for an acknowledgement the dispatcher can only send from a
#    JavaScript handler. While the dispatcher is inside any synchronous
#    child call (git pull, worktree add, qmd embed) that handler cannot
#    run, so the wrapper SIGKILLs it after 60 ms. That was the
#    2026-09-05 failure: one Ctrl+C five seconds into a gate, no banner,
#    wip:verifier stranded, worktree left behind. `--import tsx`
#    registers the same loader inside the one node process, so there is
#    no relay left to kill us.
#
# 2. The dispatcher runs in its OWN process group. perl calls setpgrp
#    and then execs node, so node's pgid is its own pid. The kernel
#    delivers a terminal Ctrl+C to the foreground process group only,
#    which is this wrapper and `op run`. Neither the dispatcher nor its
#    synchronous children (git, gh, qmd) see it. Before this the kernel
#    also killed whichever git or qmd command happened to be running at
#    the moment of the press, and the throw from that killed call parked
#    the ticket or took the poll loop down.
#
# 3. `op run` still wraps the launch so `op://` references in .env are
#    resolved at launch time (see the 2026-07-08 setup-token notes). op
#    forwards a SIGINT it receives to its child as well, so the
#    dispatcher can see one press twice a few ms apart; the dispatcher's
#    500 ms SIGINT debounce exists for exactly that shape.
#
# stdin comes from /dev/null: a process outside the foreground group
# that reads the terminal is stopped with SIGTTIN, and nothing in the
# dispatcher should ever read the terminal.
#
# History of this line: 2026-05-22 moved the claude child into its own
# group; 2026-06-07 dropped pnpm from the chain because it turned the
# SIGINT into a SIGTERM; 2026-09-05 dropped the tsx wrapper and moved the
# dispatcher itself out of the terminal's group. Do not reintroduce a
# process between `op run` and node.
# Apply the explicit runner inside the existing exec wrapper, after op has
# loaded .env. No extra process or shell quoting layer is introduced.
"$AUTOMATION_ACCESS" op run --env-file="$AGENTS_DIR/.env" -- \
  /usr/bin/perl -e 'delete $ENV{OP_SERVICE_ACCOUNT_TOKEN}; my $runner = shift @ARGV; $ENV{PYRY_AGENT_RUNNER} = $runner if length $runner; setpgrp(0, 0) or die "setpgrp: $!\n"; open(STDIN, "<", "/dev/null"); exec @ARGV or die "exec: $!\n";' -- \
  "$RUNNER_OVERRIDE" "$NODE_BIN" --import tsx src/dispatch-bin.ts "$@" &
LAUNCH_PID=$!

# Find the dispatcher's own PID for the lock: the process whose command
# line names the entry point, whose environment carries our
# AGENTS_REPO_PATH (the cross-fork disambiguator, since `pgrep -f`
# returns every fork's dispatcher), AND which leads its own process
# group (pgid == pid). The last test is what separates the dispatcher
# from `op run`, whose command line also contains the pattern and which
# inherits the same environment. Before 2026-09-05 the lock could record
# a relay instead of the dispatcher, so pyry-drain signalled the relay.
# Retry while node bootstraps.
i=0
while [ $i -lt 50 ]; do
  for pid in $(pgrep -f "tsx.*src/dispatch-bin\.ts" 2>/dev/null); do
    [ "$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$pid" ] || continue
    if ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | grep -qx "AGENTS_REPO_PATH=$AGENTS_DIR"; then
      DISPATCHER_PID="$pid"
      break
    fi
  done
  [ -n "$DISPATCHER_PID" ] && break
  # Preserve authentication failures before a dispatcher exists.
  if ! kill -0 "$LAUNCH_PID" 2>/dev/null; then
    STATUS=0
    wait "$LAUNCH_PID" || STATUS=$?
    exit "$STATUS"
  fi
  sleep 0.1
  i=$((i + 1))
done
if [ -z "$DISPATCHER_PID" ]; then
  echo "warning: could not find the dispatcher's own PID; lock records the op run PID $LAUNCH_PID and signals go through op" >&2
  DISPATCHER_PID="$LAUNCH_PID"
fi

cat > "$LOCK_FILE" <<EOF
PID=$DISPATCHER_PID
AGENTS_REPO_PATH=$AGENTS_DIR
STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

# Watch the terminal for Ctrl-R while the dispatcher runs. The terminal
# is switched out of line mode so single keys arrive without Enter, and
# each read gives up after one second so the loop notices the exit.
# Ctrl-C still raises a signal, because signal keys stay enabled. Only
# this wrapper reads the terminal; the dispatcher's input is /dev/null.
if [ -t 0 ]; then
  STTY_SAVED=$(stty -g)
  stty -icanon -echo min 0 time 10
  CTRL_R=$(printf '\022')
  echo "Ctrl-C drains and stops. Ctrl-R drains and restarts from disk."
  while kill -0 "$LAUNCH_PID" 2>/dev/null; do
    KEY=$(dd bs=1 count=1 2>/dev/null) || KEY=""
    if [ "$KEY" = "$CTRL_R" ]; then request_restart; fi
  done
  restore_tty
fi

# Block until `op run` (our direct child, so the only pid `wait` can
# follow) exits, which happens when the dispatcher exits. A trapped
# signal interrupts `wait` with a status above 128 and runs the trap;
# loop while the child is still alive. A real exit status above 128,
# such as the force-exit's 130, ends the loop because `kill -0` then
# fails; if the pid were ever reused in that instant, `wait` on a
# non-child returns 127, which also ends it.
STATUS=0
wait "$LAUNCH_PID" || STATUS=$?
while [ "$STATUS" -gt 128 ] && kill -0 "$LAUNCH_PID" 2>/dev/null; do
  STATUS=0
  wait "$LAUNCH_PID" || STATUS=$?
done

# Restart only after a clean drain. `exec` replaces this shell with a
# fresh read of the script, so the EXIT trap does not run; release the
# lock here instead. The runner choice and dispatcher arguments carry
# over unchanged.
if [ -n "$RESTART" ]; then
  if [ "$STATUS" -ne 0 ]; then
    echo "Dispatcher exited with status $STATUS. Not restarting." >&2
    exit "$STATUS"
  fi
  echo "🔁 Drain complete. Starting again."
  rm -f "$LOCK_FILE"
  if [ -n "$RUNNER_OVERRIDE" ]; then
    set -- --runner "$RUNNER_OVERRIDE" -- "$@"
  else
    set -- -- "$@"
  fi
  exec "$SCRIPT_DIR/pyry-start" "$@"
fi
exit "$STATUS"
