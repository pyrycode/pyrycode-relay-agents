#!/bin/sh
# Send SIGTERM to the running dispatcher → it finishes the current dispatch
# (whatever agents are in flight complete normally, wip:<agent> labels strip
# naturally) and exits before starting the next cycle.
#
# Idempotent — multiple SIGTERMs only print the drain notice once on the
# dispatcher side. Safe to run if no dispatcher is up; reports it.
if pkill -TERM -f "tsx.*src/dispatch-bin\.ts" 2>/dev/null; then
  echo "drain signal sent — dispatcher will exit after current dispatch completes"
else
  echo "no dispatcher running"
fi
