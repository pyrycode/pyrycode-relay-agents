# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-relay
PROJECT_NUMBER=3
GITHUB_TOKEN=op://Automation/Pyrycode-Dispatcher-PAT/credential
TARGET_REPO_PATH=/absolute/path/to/pyrycode-relay

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="go vet ./...; go build ./..."   # default value (Go), right for this repo; set "" to skip gating
# DISCORD_WEBHOOK_URL="op://Automation/Discord webhook/credential"
# CLAUDE_CODE_OAUTH_TOKEN="op://Automation/Claude long term token/password"
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

# Stage set. Unset (or "classic") runs the six-agent pipeline: po, architect,
# developer, qa, code-review, documentation. "builder" runs the four-role set
# piloted on pyrycode since 2026-09-01: refiner, builder, verifier,
# documentation. Backlog advances straight to In Development; In Architecture
# and In QA are never polled, so drain both before switching. Rollback is
# unsetting the variable and restarting.
# PYRY_STAGE_SET=builder
#
# Deterministic gates the dispatcher runs in the PR worktree BEFORE spawning the
# verifier (builder set only). `;`-separated shell commands, and the whole value
# MUST be quoted: the 1Password wrapper silently drops an unquoted value that
# contains spaces. `make check` is `go vet ./...` then `go test -race ./...`;
# `make build` builds the pyrycode-relay binary. `make lint` (gosec,
# govulncheck) is not a gate: it needs both tools installed and is run by hand.
# Each gate has a 10-minute cap in the dispatcher; on a warm build cache the
# two measured about 10s and 1s on 2026-09-24. Green injects a gates-passed note
# into the verifier; red spawns it in triage mode with the failure attached.
# Set "" to skip the step entirely.
# PYRY_VERIFIER_GATES="make check;make build"
#
# Family circuit breaker: dispatches per ticket family (root + every split
# descendant) before the family is parked under error:family-breaker. The code
# default of 24 fired on a pyrycode family that was completing normally;
# mobile runs 60 since its builder-set switch, near the ~66 dispatches the worst
# observed spiral reached.
# PYRY_FAMILY_DISPATCH_LIMIT=60
